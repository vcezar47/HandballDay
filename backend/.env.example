DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=handballday
PORT=3000
# dev (default) | test | prod
APP_ENV=dev
# signs session and CSRF cookies; required in prod, use a long random value
SECRET_KEY=change_me_to_a_long_random_string
# Public address of the site, used in sitemap.xml and robots.txt
PUBLIC_URL=http://localhost:5173
# Stripe test mode: dashboard keys, and the signing secret printed by `stripe listen`
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Cloudflare Turnstile. These two are Cloudflare's public test keys (always pass); leave both empty to turn the CAPTCHA off
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
