# Production settings. Copy to backend/.env on the server and fill in every value.
# The app refuses to start with APP_ENV=prod if DB_PASSWORD, SECRET_KEY or any Stripe/Turnstile key is missing.
APP_ENV=prod
DB_HOST=localhost
DB_PORT=5432
DB_USER=handballday
DB_PASSWORD=
DB_NAME=handballday
PORT=3000

# Long random value that signs the session and CSRF cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public address of the site, no trailing slash: used for the Stripe return URLs, sitemap.xml and robots.txt
PUBLIC_URL=https://YOUR.DOMAIN.EXAMPLE

# Stripe (test mode is fine for the course). The webhook endpoint is https://YOUR.DOMAIN.EXAMPLE/api/webhooks/stripe
# with the events checkout.session.completed and checkout.session.expired; its signing secret goes below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile: create a real widget for your domain in the Cloudflare dashboard (the public test keys are for local use only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
